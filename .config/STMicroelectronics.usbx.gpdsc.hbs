  *
 ****************************************************************************** -->
{{#with @root.config~}}
{{#if (eq ux_standalone 'No OS')~}}
{{assign 'No_OS_Mode' true~}}
{{/if}}
{{#if (eq ux_standalone 'FreeRTOS')~}}
{{assign 'FreeRTOS_Mode' true~}}
{{/if}}
{{/with}}
{{/each}}
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0"
  xs:noNamespaceSchemaLocation="https://github.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/blob/main/schema/PACK.xsd">
  {{!--Dedicated Helper that provides the PDSC PackVendor--}}
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  {{!--Dedicated Helper that provides the PDSC PackName--}}
  <name>{{@root.pdscAPI.getPackName}}</name>
  {{!--URL Tag, kept here since it is required for valid schema parsing--}}
  <url>{{@root.pdscAPI.getPackURL}}</url>
  {{!--Release Section to update manually in case of new updates--}}
  <releases>
    <release version="0.0.1" date="2025-02-05">
      - First GPDSC USBX Model Release
    </release>
  </releases>
  <conditions>
    
{{~assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="Operating System Used, Use Device Core, Use Device Controllers, Use HID Device Class, 
Use HID Mouse Device Class, Use HID Keyboard Device Class, Use HID Custom Device Class, Use CDC_ACM Device Class, Use MSC Device Class, 
Use PIMA_MTP Device Class, Use Audio Device Class, Use Video Device Class, Use Printer Device Class, Use CCID Device Class, Use DFU Device Class, 
Use Host Core, Use Host Controllers, Use HID Host Class, Use HID Mouse Host Class, Use HID Keyboard Host Class, Use HID RCU Host Class, Use CDC_ACM Host Class, 
Use MSC Host Class, Use PIMA_MTP Host Class, Use Audio Host Class, Use Video Host Class, Use Printer Host Class, Use GSER Host Class,Use PROLIFIC Host Class, 
Use SWAR Host Class, Use HUB Host Class")}}
{{{@root.conditions}}}
    <condition id="Operating System Used">
     {{#if (eq No_OS_Mode true)}}
      <require Cclass="USB" Cgroup="USBX" Csub="No_OS"/>
      {{/if}}
      {{#if (eq FreeRTOS_Mode true)}}
      <deny Cclass="USB" Cgroup="USBX" Csub="No_OS"/>
     {{/if}}
    </condition>
    <condition id="Use Device Core">
      {{#if (@root.EnvVarAPI.getVariableValue 'device_core')}}
      <require Cclass="USB" Cgroup="USBX Core" Csub="Device"/>
      <require Cclass="USB" Cgroup="USBX Device Descriptors Driver" Csub="Device"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="Device_Core"/>
      {{/if}}
    </condition>
    <condition id="Use Device Controllers">
      {{#if (@root.EnvVarAPI.getVariableValue 'device_controllers_enable')}}
      <require Cclass="USB" Cgroup="USBX Controllers Driver" Csub="Device"/>
      {{/if}}
    </condition>
    <condition id="Use HID Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'HID_Device_Class')}}
      <require Cclass="USB" Cgroup="USBX Device Class" Csub="HID"/>
      {{/if}}
    </condition>
    <condition id="Use HID Mouse Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'HID_Mouse_Device_Class')}}
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="HID_Mouse_Device_Class"/>
      {{/if}}
    </condition>
    <condition id="Use HID Keyboard Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'HID_Keyboard_Device_Class')}}
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="HID_Keyboard_Device_Class"/>
      {{/if}}
    </condition>
    <condition id="Use HID Custom Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'HID_Custom_Device_Class')}}
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="HID_Custom_Device_Class"/>
      {{/if}}
    </condition>
    <condition id="Use CDC_ACM Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'CDC_ACM_Device_Class')}}
      <require Cclass="USB" Cgroup="USBX Device Class" Csub="CDC ACM"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="CDC_ACM_Device_Class"/>
      {{/if}}
    </condition>
    <condition id="Use MSC Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'MSC_Device_Class')}}
      <require Cclass="USB" Cgroup="USBX Device Class" Csub="MSC"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="MSC_Device_Class"/>
      {{/if}}
    </condition>
    <condition id="Use PIMA_MTP Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'PIMA_MTP_Device_Class')}}
      <require Cclass="USB" Cgroup="USBX Device Class" Csub="PIMA_MTP"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="PIMA_MTP_Device_Class"/>
      {{/if}}
    </condition>
    <condition id="Use Audio Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'Audio_Device_Class')}}
      <require Cclass="USB" Cgroup="USBX Device Class" Csub="AUDIO"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="Audio_Device_Class"/>
      {{/if}}
    </condition>    
    <condition id="Use Video Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'Video_Device_Class')}}
      <require Cclass="USB" Cgroup="USBX Device Class" Csub="VIDEO"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="Video_Device_Class"/>
      {{/if}}
    </condition>    
    <condition id="Use Printer Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'Printer_Device_Class')}}
      <require Cclass="USB" Cgroup="USBX Device Class" Csub="PRINTER"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="Printer_Device_Class"/>
      {{/if}}
    </condition>    
    <condition id="Use CCID Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'CCID_Device_Class')}}
      <require Cclass="USB" Cgroup="USBX Device Class" Csub="CCID"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="CCID_Device_Class"/>
      {{/if}}
    </condition>    
    <condition id="Use DFU Device Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'DFU_Device_Class')}}
      <require Cclass="USB" Cgroup="USBX Device Class" Csub="DFU"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="DFU_Device_Class"/>
      {{/if}}
    </condition>
    <condition id="Use Host Core">
      {{#if (@root.EnvVarAPI.getVariableValue 'host_core')}}
      <require Cclass="USB" Cgroup="USBX Core" Csub="Host"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="Host_Core"/>
      {{/if}}
    </condition>
    <condition id="Use Host Controllers">
      {{#if (@root.EnvVarAPI.getVariableValue 'host_controllers_enable')}}
      <require Cclass="USB" Cgroup="USBX Controllers Driver" Csub="Host"/>
      {{/if}}
    </condition>
    <condition id="Use HID Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'HID_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="HID"/>
      {{/if}}
    </condition>
    <condition id="Use HID Mouse Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'HID_Mouse_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="HID Mouse"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="HID_Mouse_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use HID Keyboard Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'HID_Keyboard_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="HID Keyboard"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="HID_Keyboard_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use HID RCU Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'HID_RCU_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="HID RCU"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="HID_RCU_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use CDC_ACM Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'CDC_ACM_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="CDC ACM"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="CDC_ACM_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use MSC Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'MSC_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="MSC"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="MSC_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use PIMA_MTP Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'PIMA_MTP_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="PIMA_MTP"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="PIMA_MTP_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use Audio Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'Audio_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="AUDIO"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="Audio_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use Video Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'Video_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="VIDEO"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="Video_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use Printer Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'Printer_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="PRINTER"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="Printer_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use GSER Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'GSER_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="GSER"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="GSER_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use PROLIFIC Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'Prolific_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="PROLIFIC"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="Prolific_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use SWAR Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'SWAR_Host_Class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="SWAR"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="SWAR_Host_Class"/>
      {{/if}}
    </condition>
    <condition id="Use HUB Host Class">
      {{#if (@root.EnvVarAPI.getVariableValue 'HUB_host_class')}}
      <require Cclass="USB" Cgroup="USBX Host Class" Csub="HUB"/>
      {{/if}}
    </condition>
  </conditions>
  {{!-- This section will list all selected components with their descriptions, along with their generated files--}}
  <components>
    {{!-- This is a components data model constructed by the API, find below a snapshot for the return value--}}
   {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cbundle}}} {{{Cvariant}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      {{#if (and (eq Cgroup 'Cgroup="STM32CubeMX2 Config"') (eq Csub 'Csub="USBX"'))}}
        <Pre_Include_Global_h>
          #define UX_INCLUDE_USER_DEFINE_FILE
        </Pre_Include_Global_h>
      {{/if}}
      {{#if (and (eq Cgroup 'Cgroup="STM32CubeMX2 Codegen"') (eq Csub 'Csub="Device_Core"'))}}
        <Pre_Include_Global_h>
          #define USBD_INCLUDE_USER_DESC_CONFIG_FILE
        </Pre_Include_Global_h>
      {{/if}}
      <files>
        {{#each files_array}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
</package>