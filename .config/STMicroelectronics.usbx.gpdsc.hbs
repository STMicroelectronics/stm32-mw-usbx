<?xml version="1.0" encoding="UTF-8" standalone="no"?>
{{assign 'USBX_instance' (@root.SWConfigurationAPI.getInstances  "STMicroelectronics::USB:STM32CubeMX2 Config:USBX")~}}
{{assign 'No_OS_Mode' false~}}
{{assign 'FreeRTOS_Mode' false~}}
{{#each @root.USBX_instance~}}
{{assign 'USBX_ctx' (@root.SWConfigurationAPI.getInstanceConfiguration this)~}}
{{assign 'config'  @root.USBX_ctx.settings.parameters.core.basic.usb_core_system~}}
<!-- ***************************************************************************
 * File Name   : {{@root.pdscAPI.getGPDSCFileName}}
 * Description : Generator PDSC File generated by the code generator
  ******************************************************************************
