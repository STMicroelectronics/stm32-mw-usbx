{{/if}}
{{#if device_mouse}}
  report_desc_len = usbd_hid_mouse_report_length();
  usb_device_descriptor_register_class(USBD_CLASS_TYPE_HID, hid_mouse_interface, &report_desc_len);
{{/if}}
{{#if device_keyboard}}
  report_desc_len = usbd_hid_keyboard_report_length();
  usb_device_descriptor_register_class(USBD_CLASS_TYPE_HID, hid_keyboard_interface, &report_desc_len);
{{/if}}
{{#if device_custom}}
  report_desc_len = usbd_custom_hid_report_length();
  usb_device_descriptor_register_class(USBD_CLASS_TYPE_HID, hid_custom_interface, &report_desc_len);
{{/if}}
{{#if cdc_acm_class}}
  report_desc_len = sizeof(cdc_acm_parameter);
  usb_device_descriptor_register_class(USBD_CLASS_TYPE_CDC_ACM, cdc_acm_interface, &report_desc_len);
{{/if}}
{{#if msc_class}}
  report_desc_len = sizeof(storage_parameter);
  usb_device_descriptor_register_class(USBD_CLASS_TYPE_MSC, msc_interface, &report_desc_len);
{{/if}}
{{#if dfu_class}}
  report_desc_len = sizeof(dfu_parameter);
  usb_device_descriptor_register_class(USBD_CLASS_TYPE_DFU, dfu_interface, &report_desc_len);
{{/if}}
{{#if audio_class}}
  report_desc_len = sizeof(audio_parameter);
  usb_device_descriptor_register_class(USBD_CLASS_TYPE_AUDIO_20, audio_interface, &report_desc_len);
{{/if}}
{{#if video_class}}
  report_desc_len = sizeof(video_parameter);
  usb_device_descriptor_register_class(USBD_CLASS_TYPE_VIDEO, video_interface, &report_desc_len);
{{/if}}
{{#if printer_class}}
  report_desc_len = sizeof(printer_parameter);
  usb_device_descriptor_register_class(USBD_CLASS_TYPE_PRINTER, printer_interface, &report_desc_len);
{{/if}}
{{#if ccid_class}}
  report_desc_len = sizeof(ccid_parameter);
  usb_device_descriptor_register_class(USBD_CLASS_TYPE_CCID, ccid_interface, &report_desc_len);
{{/if}}
{{#if pima_mtp_class}}
  report_desc_len = sizeof(pima_mtp_parameter);
  usb_device_descriptor_register_class(USBD_CLASS_TYPE_PIMA_MTP, mtp_interface, &report_desc_len);
{{/if}}

  usb_device_descriptor_get_framework(&usbd_desc);

  /* Install the device portion of USBX */
  status = ux_device_stack_initialize(usbd_desc.device_high_speed.framework,
                                      usbd_desc.device_high_speed.framework_length,
                                      usbd_desc.device_full_speed.framework,
                                      usbd_desc.device_full_speed.framework_length,
                                      usbd_desc.string.framework,
                                      usbd_desc.string.framework_length,
                                      usbd_desc.languageid.framework,
                                      usbd_desc.languageid.framework_length,
                                      UX_NULL);

  if (status != UX_SUCCESS)
  {
    return status;
  }
{{#if device_mouse}}
  /* Initialize the hid mouse class parameters for the device */
  hid_mouse_parameter.ux_slave_class_hid_instance_activate           = usbd_hid_mouse_activate;
