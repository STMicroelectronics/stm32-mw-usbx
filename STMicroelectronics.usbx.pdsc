<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:stm32="https://developer.st.com/schemas/stm32cube/1.0.0" schemaVersion="1.7.55" xsi:noNamespaceSchemaLocation="PACK.xsd" xsi:schemaLocation="https://developer.st.com/schemas/stm32cube/1.0.0 stm32cube.xsd" Dvendor="STMicroelectronics:13" Dname="STM32*">
  <vendor>STMicroelectronics</vendor>
  <name>usbx</name>
  <environments>
    <environment name="STM32Cube">
      <stm32:pack type="MW" friendlyName="usbx" shortDesc="usbx middleware">
        <relocation-info parent="middleware" layer="" element=""/>
        <compatibility>
          <release version="2.1.0">
            <applicable-schema schemaType="sw-configuration" schemaVersion="3.9.0"/>
            <applicable-api-group apiType="codegen-getters">
              <applicable-api apiType="SWProjectAPI" apiVersion="1.0.0"/>
            </applicable-api-group>
          </release>
          <release version="2.0.0">
            <applicable-schema schemaType="sw-configuration" schemaVersion="3.8.0"/>
            <applicable-api-group apiType="codegen-getters">
              <applicable-api apiType="SWProjectAPI" apiVersion="1.0.0"/>
            </applicable-api-group>
          </release>
        </compatibility>
      </stm32:pack>
    </environment>
  </environments>
  <ECCN>
    <ECCN-EU>NEC</ECCN-EU>
    <ECCN-US>EAR99</ECCN-US>
  </ECCN>
  <description>STMicroelectronics usbx pack</description>
  <repository type="git">https://github.com/STMicroelectronics/stm32-mw-usbx/tree/hal2/</repository>
  <url>https://developer.st.com/st-pack-server/api/v1/pack/</url>
  <license>LICENSE.md</license>
  <releases>
    <release date="2026-05-08" version="2.1.0">
      USBX pack version based on the V6.5.0 Release
      ## Main changes
      * Official release of USBX aligned with HAL2.
      * Update of USBX to V6.5.0 release.
      * Miscellaneous update of .config files.
    </release>
    <release date="2026-03-06" version="2.0.0">
      USBX pack version based on the V6.4.3 Release
      ## Main changes
      * Official release of USBX aligned with HAL2.
    </release>
  </releases>
  <changelogs>
    <changelog id="Readme" name="README.md"/>
    <changelog id="Release Notes" default="true" name="ST_Release_Notes.html"/>
  </changelogs>
  <keywords>
    <keyword>Cortex-M</keyword>
    <keyword>STMicroelectronics</keyword>
    <keyword>USBX</keyword>
    <keyword>STM32</keyword>
  </keywords>
  <taxonomy>
    <description Cclass="USB">USB</description>
  </taxonomy>
  <conditions>
    <condition id="usbx standalone condition">
      <require Cclass="USB" Cgroup="USBX" Csub="No_OS"/>
    </condition>
    <condition id="usbx freertos condition">
      <deny Cclass="USB" Cgroup="USBX" Csub="No_OS"/>
      <require Cclass="RTOS" Cgroup="FreeRTOS" Csub="Core"/>
    </condition>
    <condition id="Operating System Used">
    </condition>
    <condition id="Use Device Core">
    </condition>
    <condition id="Use Device Controllers">
    </condition>
    <condition id="Use HID Device Class">
    </condition>
    <condition id="Use HID Mouse Device Class">
    </condition>
    <condition id="Use HID Keyboard Device Class">
    </condition>
    <condition id="Use HID Custom Device Class">
    </condition>
    <condition id="Use CDC_ACM Device Class">
    </condition>
    <condition id="Use MSC Device Class">
    </condition>
    <condition id="Use PIMA_MTP Device Class">
    </condition>
    <condition id="Use Audio Device Class">
    </condition>
    <condition id="Use Video Device Class">
    </condition>
    <condition id="Use Printer Device Class">
    </condition>
    <condition id="Use CCID Device Class">
    </condition>
    <condition id="Use DFU Device Class">
    </condition>
    <condition id="Use Host Controllers">
    </condition>
    <condition id="Use HID Host Class">
    </condition>
    <condition id="Use HID Mouse Host Class">
    </condition>
    <condition id="Use HID Keyboard Host Class">
    </condition>
    <condition id="Use HID RCU Host Class">
    </condition>
    <condition id="Use CDC_ACM Host Class">
    </condition>
    <condition id="Use MSC Host Class">
    </condition>
    <condition id="Use PIMA_MTP Host Class">
    </condition>
    <condition id="Use Audio Host Class">
    </condition>
    <condition id="Use Video Host Class">
    </condition>
    <condition id="Use Printer Host Class">
    </condition>
    <condition id="Use GSER Host Class">
    </condition>
    <condition id="Use PROLIFIC Host Class">
    </condition>
    <condition id="Use SWAR Host Class">
    </condition>
    <condition id="Use HUB Host Class">
    </condition>
    <condition id="Use Host Core">
    </condition>
    <condition id="usbx core condition">
      <require condition="Operating System Used"/>
      <require condition="Use Device Core"/>
      <require condition="Use Device Controllers"/>
      <require condition="Use HID Device Class"/>
      <require condition="Use HID Mouse Device Class"/>
      <require condition="Use HID Keyboard Device Class"/>
      <require condition="Use HID Custom Device Class"/>
      <require condition="Use CDC_ACM Device Class"/>
      <require condition="Use MSC Device Class"/>
      <require condition="Use PIMA_MTP Device Class"/>
      <require condition="Use Audio Device Class"/>
      <require condition="Use Video Device Class"/>
      <require condition="Use Printer Device Class"/>
      <require condition="Use CCID Device Class"/>
      <require condition="Use DFU Device Class"/>
      <require condition="Use Host Core"/>
      <require condition="Use Host Controllers"/>
      <require condition="Use HID Host Class"/>
      <require condition="Use HID Mouse Host Class"/>
      <require condition="Use HID Keyboard Host Class"/>
      <require condition="Use HID RCU Host Class"/>
      <require condition="Use CDC_ACM Host Class"/>
      <require condition="Use MSC Host Class"/>
      <require condition="Use PIMA_MTP Host Class"/>
      <require condition="Use Audio Host Class"/>
      <require condition="Use Video Host Class"/>
      <require condition="Use Printer Host Class"/>
      <require condition="Use GSER Host Class"/>
      <require condition="Use PROLIFIC Host Class"/>
      <require condition="Use SWAR Host Class"/>
      <require condition="Use HUB Host Class"/>
      <require Cclass="USB" Cgroup="USBX Core" Csub="Common"/>
    </condition>
  </conditions>
  <generators>
    <!-- This generator is launched if any component referencing this generator by 'id' is selected and the specified <gpdsc> file does not exist -->
    <generator id="usbx_mx2codegen">
      <description>STMicroelectronics: STM32 Cube Code Generator for USBX Pack</description>
      <exe>
        <command host="win">.config/gen_code.bat</command>
        <command host="linux">.config/gen_code.sh</command>
        <command host="mac">.config/gen_code.sh</command>
        <!-- #name of the gpdsc template contained in this PACK and aligned with GPDSC name-->
        <argument>STMicroelectronics.usbx.gpdsc.hbs</argument>
        <!-- passing the generator name-->
        <argument>usbx_mx2codegen</argument>
        <argument>$G</argument>
        <!-- Flag to indicate that this Generator is dry-run capable -->
        <argument mode="dry-run">--dry-run</argument>
      </exe>
      <!-- workingDir></workingDir -->
      <!-- path is specified either absolute or relative to PDSC or GPDSC file. If not specified it is the project directory configured by the environment -->
      <gpdsc name="$P/STMicroelectronics.usbx.gpdsc"/>
    </generator>
  </generators>
  <components>
    <!-- USBX utilities Standalone files -->
    <component Cclass="USB" Cgroup="USBX" Csub="No_OS" Cversion="6.5.0">
      <description>USB Standalone Mode </description>
      <files>
        <!-- case of standalone mode -->
        <file category="include" name="ports/generic/inc/"/>
      </files>
    </component>
    <!-- STM32 USBX Core -->
    <component Cclass="USB" Cgroup="USBX Core" Csub="Common" Cversion="6.5.0">
      <description>USB Core</description>
      <files>
        <file category="doc" name="ST_Release_Notes.md"/>
        <file category="doc" name="ST_Release_Notes.html"/>
        <file category="doc" name="SW_Security_Level.md"/>
        <file category="doc" name="README.md"/>
        <file category="doc" name="docs/usbx-features.png"/>
        <file category="doc" name="docs/deps.png"/>
        <!-- USBX system source files -->
        <file category="source" name="common/core/src/ux_system_error_handler.c"/>
        <file category="source" name="common/core/src/ux_system_initialize.c"/>
        <file category="source" name="common/core/src/ux_system_tasks_run.c" condition="usbx standalone condition"/>
        <file category="source" name="common/core/src/ux_system_uninitialize.c"/>
        <!-- USBX utility source files -->
        <file category="source" name="common/core/src/ux_utility_debug_callback_register.c"/>
        <file category="source" name="common/core/src/ux_utility_debug_log.c"/>
        <file category="source" name="common/core/src/ux_utility_delay_ms.c"/>
